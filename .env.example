# Copy to .env and fill in. Never commit the real .env.
# On Cloud Run these are provided via --set-env-vars or Secret Manager.

# --- Required ---
ANTHROPIC_API_KEY=        # Claude (chat agent, evaluator, RAG ranking/rewrite)
OPENAI_API_KEY=           # OpenAI embeddings (text-embedding-3-small) for RAG

# --- Chroma Cloud (required in production; leave unset to use local .chroma_db in dev) ---
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# --- Supabase (Postgres data layer; backend uses the service_role key) ---
SUPABASE_URL=             # https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=        # public anon key (frontend realtime; safe to expose)
SUPABASE_SERVICE_ROLE_KEY=  # service_role key (BACKEND ONLY — bypasses RLS, never ship to browser)
SUPABASE_DB_PASSWORD=     # Postgres password (for supabase CLI migrations)

# --- Clerk (auth) ---
CLERK_ISSUER=             # https://<slug>.clerk.accounts.dev (or prod domain); JWKS derived from this
CLERK_JWKS_URL=           # optional; defaults to <CLERK_ISSUER>/.well-known/jwks.json
CLERK_SECRET_KEY=         # backend/Next server (never expose to browser). The backend uses it to
                          # look up a new user's email (Clerk session tokens omit the email claim)
CLERK_PUBLISHABLE_KEY=    # frontend publishable key

# --- CORS ---
CORS_ORIGINS=             # optional comma-separated allowlist; defaults to localhost:3000 + the Vercel origin

# --- Optional ---
LANGCHAIN_API_KEY=        # Enables LangSmith tracing when set; tracing is off when empty
TAVILY_API_KEY=           # Web search tool (has a built-in fallback if unset)

# --- Local only ---
# PORT=8000               # Defaults to 8000 locally, 8080 on Cloud Run
